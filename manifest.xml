<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="CalendarApp">
  <Id>de22eda6-1630-4550-b107-23ce60687d0a</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Contoso</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Room-Check"/>
  <Description DefaultValue="Sichert die Raumanforderungen für Termine."/>
  <IconUrl DefaultValue="https://mbenner26.github.io/room-check/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://mbenner26.github.io/room-check/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://www.contoso.com/help"/>
  <AppDomains>
    <AppDomain>https://mbenner26.github.io/room-check</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Calendar"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Calendar" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="Appointment">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://mbenner26.github.io/room-check/taskpane/taskpane.html"/>
        <RequestedHeight>300</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Calendar"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="CalendarHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="AppointmentCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://mbenner26.github.io/room-check/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://mbenner26.github.io/room-check/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://mbenner26.github.io/room-check/assets/icon-80x80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://mbenner26.github.io/room-check/commands/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://mbenner26.github.io/room-check/taskpane/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Raum-Check"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Anforderungen ausfüllen"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Öffnet das Formular für die Raumanforderungen."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
